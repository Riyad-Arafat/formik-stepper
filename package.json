{
  "name": "formik-stepper",
  "version": "2.2.5",
  "homepage": "https://formik-stepper.web.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/riyadelberkawy/formik-stepper.git"
  },
  "author": {
    "name": "Riyad Elberkawy",
    "email": "riyad.elberkawy@gmail.com",
    "url": "https://riyad-elberkawy.tk"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./default": {
      "types": "./dist/default.d.ts",
      "import": "./dist/default.js",
      "default": "./dist/default.js"
    },
    "./persistence": {
      "types": "./dist/persistence.d.ts",
      "import": "./dist/persistence.js",
      "default": "./dist/persistence.js"
    },
    "./styles.css": "./dist/styles.css",
    "./style.css": "./dist/style.css",
    "./stepper/styles.css": "./dist/stepper/styles.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "formik": "^2.4.6",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "formik": "^2.4.6",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly && node scripts/rewrite-declaration-imports.mjs && cp src/styles.css dist/styles.css && cp src/style.css dist/style.css && mkdir -p dist/stepper && cp src/stepper/styles.css dist/stepper/styles.css",
    "lint": "eslint src test scripts docs/playground vite.config.ts vite.docs.config.ts --max-warnings 0",
    "test": "vitest run --environment jsdom",
    "test:package": "yarn build && node scripts/package-smoke.mjs",
    "test:consumers": "yarn build && node scripts/consumer-smoke.mjs",
    "docs:dev": "vite --config vite.docs.config.ts",
    "docs:build": "vite build --config vite.docs.config.ts",
    "verify": "yarn lint && yarn test && yarn test:package && yarn docs:build",
    "verify:release": "yarn verify && yarn test:consumers"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "keywords": [
    "react",
    "stepper",
    "formik",
    "form stepper",
    "validation",
    "input-stepper",
    "react-form",
    "react-select",
    "multi step form react",
    "multi step form formik",
    "multi step form",
    "formik",
    "material-ui",
    "material-ui-stepper",
    "form stepper",
    "formik stepper",
    "validation",
    "formik validation",
    "formik validation stepper",
    "formik validation stepper material-ui",
    "formik validation stepper material-ui stepper",
    "formik validation stepper material-ui stepper form",
    "material-ui validation",
    "input-stepper",
    "input stepper",
    "input-stepper-formik",
    "input stepper formik",
    "input-stepper-formik-material-ui",
    "input stepper formik material-ui",
    "input-stepper-formik-material-ui-validation",
    "form",
    "formik",
    "formik-material-ui",
    "formik-material-ui-stepper",
    "formik-material-ui-stepper-validation",
    "formik-material-ui-stepper-validation-input",
    "formik-material-ui-stepper-validation-input-stepper",
    "react-form",
    "react form",
    "react-form-stepper",
    "react form stepper",
    "react-form-stepper-formik",
    "react-select",
    "react-input-stepper",
    "react-formik",
    "react-input-stepper",
    "react-input-stepper-formik",
    "react-input-stepper-formik-validation",
    "react-input-stepper-formik-validation-react-select",
    "react-input-stepper-formik-validation-react-select-formik",
    "react-input-stepper-formik-validation-react-select-formik-form-stepper",
    "react-input-stepper-formik-validation-react-select-formik-form-stepper-validation",
    "multi step form react",
    "multi step form formik",
    "multi step form"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "react-select": "^5.10.2"
  }
}
